SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_ORIGIN=http://127.0.0.1:4173
BACKEND_PORT=4177
SESSION_STORE=memory
ALLOW_SUPABASE_SESSION_WRITES=false
CSRF_SECRET=
BACKEND_METRICS=false
PW2_ECONOMY_ENABLED=false
PW2_RAFFLE_PRICE=
PW2_RAFFLE_MAX=
PW2_GAMES_ENABLED=auto
DATABASE_URL=
# Certificado CA PEM descargado del proyecto Supabase (multilínea o con \n).
# Vacío: utiliza las autoridades de confianza predeterminadas de Node.
DATABASE_SSL_CA=
PERRIWEB_PROXY_SECRET=
# Railway: NODE_ENV=production, PUBLIC_ORIGIN=origen HTTPS definitivo
# SESSION_STORE=supabase, ALLOW_SUPABASE_SESSION_WRITES=true
# CSRF_SECRET y PERRIWEB_PROXY_SECRET: secretos aleatorios distintos >=32 caracteres.


# Google: habilitar solamente después de SQL 002 y revisión/configuración.
PW2_GOOGLE_ENABLED=false
# Clave pública publishable o anon del MISMO proyecto Supabase (no service_role).
SUPABASE_PUBLISHABLE_KEY=
# Textos legales: revisar docs/google-auth/legal; no se incluyen en dist.
PW2_LEGAL_PUBLISHED=false
PW2_LEGAL_DIRECTORY=
